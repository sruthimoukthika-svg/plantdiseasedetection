# Backend
PDAI_MODEL_DIR=./checkpoints
PDAI_MAX_UPLOAD_BYTES=10485760
PDAI_MAX_IMAGE_PIXELS=25000000
# localhost and 127.0.0.1 are distinct origins to a browser - list both
PDAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PDAI_PERSIST_UPLOADS=false

# Thresholds (calibrated in Stage 4; these are placeholders until then)
PDAI_SPECIES_MIN_CONFIDENCE=0.0
PDAI_DISEASE_MIN_CONFIDENCE=0.0
PDAI_OOD_MAX_SCORE=0.0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
